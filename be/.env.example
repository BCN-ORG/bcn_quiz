# Server (use 3001 locally if profiles already uses 3000)
APP_PORT=3001
PORT=3001 # optional
HOST_PORT=18086
FE_APP_PORT=5173
FE_HOST_PORT=18088
BODY_LIMIT=5mb # optional
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173 # optional

# --- Local (same Postgres / Redis / MinIO containers as bcn_profiles) ---
# Postgres published on host :5433
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/bcn_quiz?schema=public # optional, generated on production
# Redis on host :6379 (leave REDIS_HOST empty so REDIS_URL is used)
REDIS_URL=redis://localhost:6379 # optional, disabled on production
REDIS_HOST= # optional
REDIS_PORT=6379
REDIS_PASSWORD= # optional
REDIS_PREFIX=quizzes:

# Shared production PostgreSQL (CI/server). Prefer DATABASE_URL locally.
DB_HOST=postgres # optional on local when DATABASE_URL is set
DB_PORT=5432
DB_DATABASE=quizzes
DB_USERNAME=quizzes_app
DB_PASSWORD=
DB_SCHEMA=public
DB_POOL_MAX=10 # optional
DB_POOL_WARM=4 # optional
DB_POOL_IDLE_MS=300000 # optional
DB_POOL_CONNECT_TIMEOUT_MS=10000 # optional
DB_POOL_KEEPALIVE_DELAY_MS=10000 # optional
PRISMA_TX_MAX_WAIT_MS=10000 # optional
PRISMA_TX_TIMEOUT_MS=20000 # optional

# BCN Profiles SSO. The issuer is browser-facing; the API base is used
# server-to-server and may use Docker DNS in production.
PROFILES_API_BASE_URL=https://profiles.bcn.id.vn/api
BCN_OAUTH_ISSUER=https://profiles.bcn.id.vn/api
BCN_OAUTH_CLIENT_ID=bcn-quiz
BCN_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/callback
BCN_OAUTH_SUCCESS_REDIRECT_URL=http://localhost:5173/dashboard
BCN_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000 # optional, 30 days
# Application server key issued once by Profiles Admin -> Applications.
PROFILES_CLIENT_SECRET=
PROFILES_HTTP_TIMEOUT_MS=10000 # optional
PROFILES_WARMUP_TIMEOUT_MS=3000 # optional
AUTH_CACHE_TTL_MS=0 # optional

MINIO_IMAGE_MAX_BYTES=3145728 # optional
MINIO_QUIZ_IMAGE_FOLDER=quiz-images # optional
MINIO_TOPIC_IMAGE_FOLDER=topic-images # optional
MINIO_COURSE_IMAGE_FOLDER=course-images # optional
MINIO_PROJECT_FOLDER=project-submissions # optional
MINIO_PROJECT_REQUIREMENT_FOLDER=project-requirements # optional


# Local MinIO (same container as bcn_profiles). Production: https://storage.bcn.id.vn
MINIO_ENDPOINT=http://127.0.0.1:9010
MINIO_BUCKET=quizzes
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1 # optional
MINIO_FORCE_PATH_STYLE=true
