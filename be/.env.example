# ------------------------------------------------------------------------------
# BCN Quiz Backend Environment Variables (.env.example)
# Copy to .env and adjust variables for your target environment (local dev vs prod).
# ------------------------------------------------------------------------------

# Environment: 'development' | 'production' | 'test'
NODE_ENV=development # optional, default development

# Server & Network (use 3001 locally if profiles already uses 3000)
APP_PORT=3001
PORT=3001 # optional fallback
HOST_PORT=18086 # optional docker host port
FE_APP_PORT=3000 # optional
FE_HOST_PORT=18088 # optional
BODY_LIMIT=5mb # optional
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173 # optional, comma-separated list of allowed origins

# --- Database (PostgreSQL with Prisma 7 + pg driver adapter) ---
# Local dev: published on host :5433
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/bcn_quiz?schema=public # optional, generated on production
# Shared production PostgreSQL (CI/server). Prefer DATABASE_URL locally.
DB_HOST=postgres # optional on local when DATABASE_URL is set
DB_PORT=5432
DB_DATABASE=quizzes
DB_USERNAME=quizzes_app
DB_PASSWORD=
DB_SCHEMA=public
DB_POOL_MAX=10 # optional connection pool maximum
DB_POOL_WARM=4 # optional warmed connection count on startup
DB_POOL_IDLE_MS=300000 # optional idle connection timeout (5 mins)
DB_POOL_CONNECT_TIMEOUT_MS=10000 # optional connection timeout (10s)
DB_POOL_KEEPALIVE_DELAY_MS=10000 # optional keepalive ping interval (10s)
PRISMA_TX_MAX_WAIT_MS=10000 # optional max wait time for transaction
PRISMA_TX_TIMEOUT_MS=20000 # optional max duration of transaction
REQUEST_QUERY_LOG=true # optional, log database queries with duration in ms

# --- Redis (Cache, Throttler & Locks) ---
# Local dev: Redis on host :6379 (leave REDIS_HOST empty so REDIS_URL is used)
REDIS_URL=redis://localhost:6379 # optional, disabled on production
REDIS_HOST= # optional standalone host (e.g. redis)
REDIS_PORT=6379 # optional
REDIS_PASSWORD= # optional, required in production
REDIS_PREFIX=quizzes: # optional key prefix for cache and throttler
REDIS_KEY_PREFIX=bcn:quiz: # optional alternative prefix
# Redis Sentinel (High Availability in production)
REDIS_SENTINELS= # optional: host1:26379,host2:26379
REDIS_SENTINEL_NAME= # optional: mymaster
REDIS_SENTINEL_PASSWORD= # optional

# --- Rate limiting (per client IP, shared Redis counter) ---
# Defaults: 300 requests / 60 s (1000 when NODE_ENV=development). Lower THROTTLE_LIMIT (e.g. 100) to tighten.
# THROTTLE_LIMIT=300
# THROTTLE_TTL_MS=60000

# --- BCN Profiles SSO & OAuth ---
# The issuer is browser-facing; the API base is used server-to-server and may use Docker DNS in production.
PROFILES_API_BASE_URL=https://profiles.bcn.id.vn/api
BCN_OAUTH_ISSUER=https://profiles.bcn.id.vn/api
BCN_OAUTH_CLIENT_ID=bcn-quiz
BCN_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/callback
BCN_OAUTH_SUCCESS_REDIRECT_URL=http://localhost:5173/dashboard
BCN_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000 # optional, 30 days
# Application server key issued once by Profiles Admin -> Applications
PROFILES_CLIENT_SECRET=
PROFILES_HTTP_TIMEOUT_MS=10000 # optional timeout for Profiles calls
PROFILES_WARMUP_TIMEOUT_MS=3000 # optional warmup ping timeout
AUTH_CACHE_TTL_MS=60000 # optional, cache token validation in Redis (e.g. 60000ms = 60s) to prevent upstream Profiles /me socket exhaustion on page navigation

# --- Object Storage (MinIO / S3) ---
# Local MinIO: http://127.0.0.1:9010. Production: https://storage.bcn.id.vn
MINIO_ENDPOINT=http://127.0.0.1:9010
MINIO_BUCKET=quizzes
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1 # optional
MINIO_FORCE_PATH_STYLE=true # optional, true for MinIO, false for AWS S3
MINIO_IMAGE_MAX_BYTES=3145728 # optional, 3MB image size limit
MINIO_QUIZ_IMAGE_FOLDER=quiz-images # optional
MINIO_TOPIC_IMAGE_FOLDER=topic-images # optional
MINIO_COURSE_IMAGE_FOLDER=course-images # optional
MINIO_PROJECT_FOLDER=project-submissions # optional
MINIO_PROJECT_REQUIREMENT_FOLDER=project-requirements # optional
# Project uploads: true keeps legacy presigned PUT; false enforces size-limited presigned POST
UPLOAD_ALLOW_LEGACY_PUT=true # optional

# --- Daily Quiz Tower Gameplay & Cooldown ---
# Production: cooldown bật (true), phạt 4 tiếng (14400s) khi làm sai/hết giờ
# Development: TOWER_COOLDOWN_ENABLED=false, TOWER_COOLDOWN_SECONDS=0 để dev/test liên tục không bị khóa
TOWER_COOLDOWN_ENABLED=true # optional, set false on local dev to disable cooldown penalty
TOWER_COOLDOWN_SECONDS=14400 # optional, cooldown duration in seconds (14400 = 4 hours)
TOWER_QUESTION_TIME_LIMIT_SECONDS=10 # optional, time limit per question in seconds (default 10)

# --- External Coin Service (Optional) ---
# If left empty, backend automatically uses MockCoinProvider for test coins
COIN_API_BASE_URL= # optional, e.g. https://profiles.bcn.id.vn/api/coins
COIN_API_KEY= # optional
COIN_API_TIMEOUT_MS=5000 # optional, default 5000ms
