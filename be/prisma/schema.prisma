// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Topic {
  id            String    @id @default(cuid())
  name          String
  slug          String
  imageUrl      String?
  imagePublicId String?
  /// Calendar open window (null = always open). Inclusive start, exclusive end.
  startsAt      DateTime?
  endsAt        DateTime?

  quizzes            Quiz[]
  attempts           QuizAttempt[]
  progresses         TopicProgress[]
  sessions           AttemptSession[]
  courseLinks        CourseTopic[]
  leaderboardResults TopicLeaderboardResult[]

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([slug, createdAt])
  @@index([startsAt, endsAt])
  @@map("topics")
}

model Quiz {
  id       String @id @default(cuid())
  quizCode String

  question    String
  code        String?
  explanation String?
  answer      String

  imageUrl      String?
  imagePublicId String?

  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  options  Option[]
  attempts QuizAttempt[]
  sessions AttemptSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([topicId, quizCode])
  @@index([createdAt])
  @@index([topicId, createdAt])
  @@index([quizCode, createdAt])
  @@map("quizzes")
}

model Option {
  id String @id @default(cuid())

  label   String // A, B, C, D
  content String
  isCode  Boolean @default(false)

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@map("options")
}

model QuizAttempt {
  id             String    @id @default(cuid())
  userId         String
  quizId         String
  topicId        String
  sessionId      String?
  selectedAnswer String
  isCorrect      Boolean
  score          Int       @default(0)
  startedAt      DateTime?
  submittedAt    DateTime  @default(now())
  durationMs     Int?
  createdAt      DateTime  @default(now())

  quiz    Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  topic   Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  session AttemptSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, submittedAt])
  @@index([userId, quizId, submittedAt])
  @@index([topicId, submittedAt])
  @@index([sessionId])
  @@map("quiz_attempts")
}

model TopicProgress {
  id                  String    @id @default(cuid())
  userId              String
  topicId             String
  totalAttempts       Int       @default(0)
  correctAttempts     Int       @default(0)
  accuracy            Float     @default(0)
  isCompleted         Boolean   @default(false)
  completedAt         DateTime?
  completionThreshold Float     @default(0.8)
  lastAttemptAt       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId, updatedAt])
  @@map("topic_progresses")
}

enum CourseProgressStatus {
  IN_PROGRESS
  TOPICS_COMPLETED
  PROJECT_PENDING_APPROVAL
  COMPLETED
}

enum ProjectSubmissionStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model Course {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?
  imageUrl      String?
  imagePublicId String?
  hasProject    Boolean  @default(false)
  topicWeight   Int      @default(50)
  projectWeight Int      @default(50)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  topics              CourseTopic[]
  projectRequirement  CourseProjectRequirement?
  userProgresses      UserCourseProgress[]
  submissions         ProjectSubmission[]
  certificates        Certificate[]
  certificateRequests CertificateRequest[]

  @@index([createdAt])
  @@map("courses")
}

model CourseTopic {
  id        String   @id @default(cuid())
  courseId  String
  topicId   String
  sortOrder Int
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topic  Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([courseId, topicId])
  @@index([courseId, sortOrder])
  @@map("course_topics")
}

model CourseProjectRequirement {
  id                     String    @id @default(cuid())
  courseId               String    @unique
  title                  String
  description            String?
  isRequired             Boolean   @default(true)
  /// Optional brief/spec file (pdf/docx/zip/rar) for detailed requirements
  attachmentUrl          String?
  attachmentPublicId     String?
  attachmentOriginalName String?
  /// Optional deadline shown to learners; late submissions are labelled, never blocked
  dueAt                  DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  course      Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions ProjectSubmission[]

  @@map("course_project_requirements")
}

model UserCourseProgress {
  id                     String               @id @default(cuid())
  userId                 String
  courseId               String
  topicProgressPercent   Int                  @default(0)
  projectProgressPercent Int                  @default(0)
  progressPercent        Int                  @default(0)
  status                 CourseProgressStatus @default(IN_PROGRESS)
  topicsCompletedAt      DateTime?
  projectApprovedAt      DateTime?
  completedAt            DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId, status, updatedAt])
  @@map("user_course_progresses")
}

model ProjectSubmission {
  id            String                  @id @default(cuid())
  userId        String
  courseId      String
  requirementId String
  note          String?
  status        ProjectSubmissionStatus @default(PENDING_REVIEW)
  reviewerId    String?
  reviewerNote  String?
  reviewedAt    DateTime?
  submittedAt   DateTime                @default(now())
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  course      Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  requirement CourseProjectRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  files       ProjectSubmissionFile[]

  @@unique([userId, courseId])
  @@index([courseId, status, submittedAt])
  @@index([userId, courseId, submittedAt])
  @@map("project_submissions")
}

model ProjectSubmissionFile {
  id           String   @id @default(cuid())
  submissionId String
  filePath     String
  storageKey   String?
  originalName String
  mimeType     String?
  fileSize     Int?
  sortOrder    Int
  createdAt    DateTime @default(now())

  submission ProjectSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, sortOrder])
  @@map("project_submission_files")
}

model Certificate {
  id              String    @id @default(cuid())
  userId          String
  courseId        String
  certificateCode String    @unique
  issuedAt        DateTime  @default(now())
  metadata        Json?
  // Set when an admin revokes it: the certificate is kept as a record but no longer verifies as valid.
  revokedAt       DateTime?
  revokedBy       String?
  revokedReason   String?
  createdAt       DateTime  @default(now())

  course   Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  requests CertificateRequest[]

  @@unique([userId, courseId])
  @@index([userId, issuedAt])
  @@map("certificates")
}

/// A certificate is only issued after an admin approves the request that a completed course creates.
enum CertificateRequestStatus {
  PENDING
  ON_HOLD
  APPROVED
  REJECTED
  REVOKED
}

model CertificateRequest {
  id            String                   @id @default(cuid())
  userId        String
  courseId      String
  status        CertificateRequestStatus @default(PENDING)
  requestedAt   DateTime                 @default(now())
  resubmittedAt DateTime?
  reviewerId    String?
  reviewerNote  String?
  reviewedAt    DateTime?
  certificateId String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  certificate Certificate? @relation(fields: [certificateId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@index([status, requestedAt])
  @@index([courseId, status])
  @@map("certificate_requests")
}

enum AttemptSessionStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

model AttemptSession {
  id            String               @id @default(cuid())
  userId        String
  topicId       String
  currentQuizId String?
  status        AttemptSessionStatus @default(IN_PROGRESS)
  answers       Json
  startedAt     DateTime             @default(now())
  lastSeenAt    DateTime             @default(now())
  expiresAt     DateTime
  submittedAt   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  topic             Topic                   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  currentQuiz       Quiz?                   @relation(fields: [currentQuizId], references: [id], onDelete: SetNull)
  attempts          QuizAttempt[]
  leaderboardResult TopicLeaderboardResult?

  @@index([userId, topicId, status, updatedAt])
  @@index([userId, status, expiresAt])
  @@index([userId, topicId, submittedAt])
  @@map("attempt_sessions")
}

model TopicLeaderboardResult {
  id             String   @id @default(cuid())
  userId         String
  topicId        String
  sessionId      String   @unique
  businessDate   String   @db.VarChar(10)
  score          Int
  correctCount   Int
  totalQuestions Int
  durationMs     Int
  submittedAt    DateTime
  createdAt      DateTime @default(now())
  // true = the user's one official result for this topic (their first submit ever); NULL = an older duplicate that is
  // kept as history but never ranked. NULLs are distinct in PostgreSQL, so this unique allows many NULL rows and
  // exactly one true row per user and topic, whatever the code does.
  isCounted      Boolean?

  topic   Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  session AttemptSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId, businessDate])
  @@unique([userId, topicId, isCounted])
  @@index([topicId, businessDate, score])
  @@index([submittedAt])
  @@map("topic_leaderboard_results")
}

enum NotificationType {
  LEADERBOARD_RESULT
  LEADERBOARD_TOP10
  LEADERBOARD_TOP3
  LEADERBOARD_RANK_DROPPED
  DAILY_REMINDER
  WEEKLY_PROGRESS
  WEEKLY_SUMMARY
  CERTIFICATE_APPROVED
  CERTIFICATE_REJECTED
  CERTIFICATE_REVOKED
}

model Notification {
  id                  String           @id @default(cuid())
  userId              String
  type                NotificationType
  title               String
  message             String
  topicId             String?
  leaderboardResultId String?
  businessDate        String?          @db.VarChar(10)
  weekStart           String?          @db.VarChar(10)
  dedupKey            String           @unique
  isRead              Boolean          @default(false)
  readAt              DateTime?
  createdAt           DateTime         @default(now())

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ----------------------------------------------------------------------------
// DAILY QUIZ TOWER MODULE (LEO THÁP KIẾN THỨC)
// ----------------------------------------------------------------------------

enum TowerAttemptStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum TowerRewardStatus {
  PENDING
  SUCCESS
  FAILED
  UNKNOWN
}

model TowerSeason {
  id        String   @id @default(cuid())
  seasonKey String   @unique
  name      String
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progresses   TowerUserProgress[]
  attempts     TowerFloorAttempt[]
  transactions TowerRewardTransaction[]

  @@index([isActive, startsAt, endsAt])
  @@map("tower_seasons")
}

model TowerUserProgress {
  id                    String    @id @default(cuid())
  userId                String
  seasonId              String
  currentFloor          Int       @default(1)
  highestCompletedFloor Int       @default(0)
  cooldownUntil         DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  season TowerSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonId])
  @@index([userId, seasonId])
  @@map("tower_user_progresses")
}

model TowerFloorAttempt {
  id                       String             @id @default(cuid())
  userId                   String
  seasonId                 String
  floor                    Int
  requiredStreak           Int
  currentStreak            Int                @default(0)
  status                   TowerAttemptStatus @default(IN_PROGRESS)
  currentQuizId            String?
  currentQuestionStartedAt DateTime?
  currentQuestionExpiresAt DateTime?
  currentQuestionNumber    Int                @default(1)
  usedQuizIds              Json               @default("[]")
  failedReason             String?
  startedAt                DateTime           @default(now())
  completedAt              DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  season TowerSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@index([userId, seasonId, floor, status])
  @@index([userId, status, currentQuestionExpiresAt])
  @@map("tower_floor_attempts")
}

model TowerRewardTransaction {
  id              String            @id @default(cuid())
  userId          String
  seasonId        String
  floor           Int
  rewardCoins     Int               @default(1)
  idempotencyKey  String            @unique
  externalTxId    String?
  status          TowerRewardStatus @default(PENDING)
  requestPayload  Json?
  responsePayload Json?
  retryCount      Int               @default(0)
  errorMessage    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  processedAt     DateTime?

  season TowerSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonId, floor])
  @@index([status, retryCount, createdAt])
  @@index([userId, createdAt])
  @@map("tower_reward_transactions")
}


// ----------------------------------------------------------------------------
// OFFICIAL XP (append-only ledger; idempotent per userId + sourceType + sourceKey)
// ----------------------------------------------------------------------------

enum XpSourceType {
  TOPIC_FIRST_SUBMIT
  TOWER_FLOOR
  COURSE_COMPLETED
  CERTIFICATE_ISSUED
  BOSS_SESSION_COMPLETED
  BOSS_COMBO_STREAK
}

model UserXpEvent {
  id         String       @id @default(uuid())
  userId     String
  sourceType XpSourceType
  sourceKey  String
  amount     Int
  createdAt  DateTime     @default(now())

  @@unique([userId, sourceType, sourceKey])
  @@index([userId])
  @@map("user_xp_events")
}

// ----------------------------------------------------------------------------
// WEEKLY COMMUNITY BOSS BATTLE MODULE
// ----------------------------------------------------------------------------

enum BossSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum BossRewardStatus {
  PENDING
  SUCCESS
  FAILED
  UNKNOWN
}

model BossWeeklySeason {
  id              String    @id @default(cuid())
  weekKey         String    @unique // e.g. "2026-W46"
  name            String
  bossName        String    @default("Ma Vương Hư Không")
  bossMaxHp       Int       @default(1500)
  milestoneConfig Json      @default("[{\"at\":300,\"coin\":5,\"name\":\"Rương Đồng\"},{\"at\":600,\"coin\":5,\"name\":\"Rương Bạc\"},{\"at\":900,\"coin\":5,\"name\":\"Rương Vàng\"},{\"at\":1200,\"coin\":5,\"name\":\"Rương Bạch Kim\"},{\"at\":1500,\"coin\":5,\"name\":\"Rương Kim Cương\"}]")
  startsAt        DateTime
  endsAt          DateTime
  isActive        Boolean   @default(true)
  isSettled       Boolean   @default(false)
  settledAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions            BossBattleSession[]
  userWeeklyStats     BossUserWeeklyStat[]
  rewardTransactions  BossRewardTransaction[]

  @@index([isActive, startsAt, endsAt])
  @@map("boss_weekly_seasons")
}

model BossBattleSession {
  id                       String            @id @default(cuid())
  userId                   String
  seasonId                 String
  status                   BossSessionStatus @default(IN_PROGRESS)
  score                    Int               @default(0)
  combo                    Int               @default(0)
  maxCombo                 Int               @default(0)
  totalAnswered            Int               @default(0)
  correctCount             Int               @default(0)
  wrongCount               Int               @default(0)
  currentQuestionId        String?
  currentQuestionNumber    Int               @default(1)
  currentQuestionStartedAt DateTime?
  currentQuestionExpiresAt DateTime?
  usedQuestionIds          Json              @default("[]")
  startedAt                DateTime          @default(now())
  expiresAt                DateTime          // startedAt + 300 seconds (5 mins)
  endedAt                  DateTime?
  endReason                String?           // TIME_UP_5M, GIVE_UP, COMPLETED
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  season BossWeeklySeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@index([userId, seasonId, status])
  @@index([userId, status, expiresAt])
  @@map("boss_battle_sessions")
}

model BossUserWeeklyStat {
  id              String   @id @default(cuid())
  userId          String
  seasonId        String
  highestScore    Int      @default(0) // Personal best of the week
  totalAttempts   Int      @default(0)
  bestCombo       Int      @default(0)
  hasParticipated Boolean  @default(false)
  lastPlayedAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  season BossWeeklySeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonId])
  @@index([seasonId, highestScore])
  @@map("boss_user_weekly_stats")
}

model BossRewardTransaction {
  id              String           @id @default(cuid())
  userId          String
  seasonId        String
  milestoneIndex  Int              // 1..5
  milestoneAt     Int              // e.g. 300, 600, ...
  rewardCoins     Int              @default(5)
  idempotencyKey  String           @unique
  externalTxId    String?
  status          BossRewardStatus @default(PENDING)
  requestPayload  Json?
  responsePayload Json?
  retryCount      Int              @default(0)
  errorMessage    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  processedAt     DateTime?

  season BossWeeklySeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonId, milestoneIndex])
  @@index([status, retryCount, createdAt])
  @@index([userId, createdAt])
  @@map("boss_reward_transactions")
}
